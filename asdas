<!DOCTYPE html>
<html lang="en" data-tab="inputs">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Metabolic Engine — Calorie Deficit & Weight Loss Calculator</title>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

  <!-- External stylesheet -->
  <link rel="stylesheet" href="style.css" />

  <!-- UI Polish: Smooth Transitions & Object Resizing -->
  <style>
    /* Ultra-smooth tab panel fade-in */
    .tab-panel.active {
      animation: smoothFade 0.6s cubic-bezier(0.22, 1, 0.36, 1) 1 both !important;
    }
    @keyframes smoothFade {
      from { opacity: 0; transform: translateY(15px); }
      to { opacity: 1; transform: translateY(0); }
    }
    
    /* Ensure 3D objects are large and well-positioned on desktop */
    @media (min-width: 769px) {
      .bag-scene, .gloves-scene, .speedbag-scene {
        width: 250px !important;
        right: 4% !important;
      }
    }
  </style>
</head>

<body data-tab="inputs">

  <!-- ── Corner decorative accent ── -->
  <div class="corner-accent"></div>

  <!-- ══════════════════════════════════════════════════════════════════════
       DECORATIVE 3D OBJECTS — Cleaned structural wrappers, boosted size
       ══════════════════════════════════════════════════════════════════════ -->

  <!-- ── 1. HEAVY PUNCHING BAG SCENE (Inputs tab) ── -->
  <div class="bag-scene tab-active">
    <div class="bag-container" style="top: 0;">
      <div class="tilt-wrapper">
        <img src="bag.png" alt="Heavy Bag" style="width: 445px; height: auto; filter: drop-shadow(0 15px 25px rgba(0,0,0,0.6));">
      </div>
    </div>
  </div>


  <!-- ── 2. BOXING GLOVES SCENE (Results tab) ── -->
  <div class="gloves-scene">
    <div class="gloves-container" style="top: 0;">
      <div class="tilt-wrapper">
        <img src="gloves.png" alt="Boxing Gloves" style="width: 170px; height: auto; filter: drop-shadow(0 15px 25px rgba(0,0,0,0.6));">
      </div>
    </div>
  </div>


  <!-- ── 3. CHAMPIONSHIP TROPHY SCENE (Timeline tab) ── -->
  <div class="speedbag-scene">
    <div class="speedbag-container" style="top: 15px;">
      <div class="tilt-wrapper">
        <img src="trophy.png" alt="Championship Trophy" style="width: 140px; height: auto; filter: drop-shadow(0 15px 25px rgba(229, 57, 53, 0.3));">
      </div>
    </div>
  </div>


  <!-- ══════════════════════════════════════════════════════════════════════
       HEADER
       ══════════════════════════════════════════════════════════════════════ -->
  <header class="header">
    <div class="header-eyebrow">Metabolic Engine</div>
    <h2><em>Calorie Deficit</em><br>&amp; Weight Loss Calculator</h2>
    <div class="header-rule"></div>
  </header>


  <!-- ══════════════════════════════════════════════════════════════════════
       TAB BAR
       ══════════════════════════════════════════════════════════════════════ -->
  <nav class="tabs" role="tablist">
    <button class="tab active" data-tab="inputs"   role="tab" aria-selected="true">Inputs</button>
    <button class="tab"        data-tab="results"  role="tab" aria-selected="false">Results</button>
    <button class="tab"        data-tab="timeline" role="tab" aria-selected="false">Timeline</button>
  </nav>


  <!-- ══════════════════════════════════════════════════════════════════════
       TAB PANEL — INPUTS
       ══════════════════════════════════════════════════════════════════════ -->
  <div class="tab-panel active" id="tab-inputs" role="tabpanel">
    <div class="main">

      <!-- ── LEFT PANEL: Body Metrics ── -->
      <div class="panel-left">

        <p class="section-label">Body Metrics</p>

        <!-- Gender Toggle -->
        <div class="form-group">
          <div class="form-label">Gender</div>
          <div class="gender-toggle">
            <button class="gender-btn active" data-gender="male" id="btn-male">♂ Male</button>
            <button class="gender-btn" data-gender="female" id="btn-female">♀ Female</button>
          </div>
        </div>

        <!-- Age -->
        <div class="form-group">
          <label class="form-label" for="input-age">Age</label>
          <div class="input-wrap">
            <input type="number" id="input-age" placeholder="25" min="10" max="100" />
            <span class="input-suffix">yrs</span>
          </div>
        </div>

        <!-- Height with cm / ft toggle -->
        <div class="form-group">
          <div class="form-label">
            <span>Height</span>
            <div class="unit-pill" id="height-unit-pill">
              <button class="active" data-unit="cm">cm</button>
              <button data-unit="ft">ft</button>
            </div>
          </div>
          <div class="input-row two" id="height-input-row">
            <div class="input-wrap">
              <input type="number" id="input-height-cm" placeholder="175" min="100" max="250" />
              <span class="input-suffix">cm</span>
            </div>
          </div>
          <div class="input-row two" id="height-input-row-ft" style="display:none;">
            <div class="input-wrap">
              <input type="number" id="input-height-ft" placeholder="5" min="3" max="8" />
              <span class="input-suffix">ft</span>
            </div>
            <div class="input-wrap">
              <input type="number" id="input-height-in" placeholder="9" min="0" max="11" />
              <span class="input-suffix">in</span>
            </div>
          </div>
        </div>

        <!-- Weight with kg / lbs toggle + BMI tile -->
        <div class="form-group">
          <div class="form-label">
            <span>Current Weight</span>
            <div class="unit-pill" id="weight-unit-pill">
              <button class="active" data-unit="kg">kg</button>
              <button data-unit="lbs">lbs</button>
            </div>
          </div>
          <div class="input-row two">
            <div class="input-wrap">
              <input type="number" id="input-weight" placeholder="75" min="30" max="400" />
              <span class="input-suffix" id="weight-suffix">kg</span>
            </div>
            <!-- BMI Tile -->
            <div class="bmi-tile">
              <div class="metric-label" style="margin-bottom:4px;">BMI</div>
              <div class="metric-value red" id="bmi-value" style="font-size:20px;">—</div>
              <div class="metric-sub" id="bmi-category">—</div>
            </div>
          </div>
        </div>

        <!-- Goal Weight -->
        <div class="form-group">
          <div class="form-label">
            <span>Goal Weight</span>
          </div>
          <div class="input-wrap">
            <input type="number" id="input-goal-weight" placeholder="68" min="30" max="400" />
            <span class="input-suffix" id="goal-weight-suffix">kg</span>
          </div>
        </div>

        <p class="section-label" style="margin-top:24px;">Activity Level</p>

        <!-- Workout Days Slider -->
        <div class="slider-group">
          <div class="slider-header">
            <div class="form-label" style="margin-bottom:0;">Workout Days / Week</div>
            <div>
              <span class="slider-val" id="days-slider-val">4</span>
              <span class="slider-val-unit">days</span>
            </div>
          </div>
          <input
            type="range"
            id="days-slider"
            min="0"
            max="7"
            value="4"
            step="1"
            style="--prog:57%;"
          />
        </div>

        <!-- Intensity Buttons -->
        <div class="form-group">
          <div class="form-label">Workout Intensity</div>
          <div class="intensity-grid">
            <button class="intensity-btn" data-intensity="sedentary">
              Sedentary<br/><span>desk job</span>
            </button>
            <button class="intensity-btn" data-intensity="light">
              Light<br/><span>walking</span>
            </button>
            <button class="intensity-btn active" data-intensity="moderate">
              Moderate<br/><span>gym 3–5×</span>
            </button>
            <button class="intensity-btn" data-intensity="heavy">
              Heavy<br/><span>hard 6–7×</span>
            </button>
            <button class="intensity-btn" data-intensity="athlete">
              Athlete<br/><span>2× daily</span>
            </button>
          </div>
        </div>

      </div><!-- /panel-left -->


      <!-- ── RIGHT PANEL: Calorie Targets ── -->
      <div class="panel-right">

        <!-- TDEE Display -->
        <p class="section-label">Estimated TDEE</p>
        <div class="tdee-block">
          <div class="tdee-label">Total Daily Energy Expenditure</div>
          <div class="tdee-grid">
            <div>
              <div class="tdee-num red" id="tdee-value">—</div>
              <div class="tdee-sub">kcal / day</div>
            </div>
            <div>
              <div class="tdee-num" id="tdee-weekly" style="color:var(--text2);">—</div>
              <div class="tdee-sub">kcal / week</div>
            </div>
          </div>
          <div class="tdee-divider" id="tdee-bmr-line">
            BMR: <span id="tdee-bmr-val">—</span> kcal · Mifflin-St Jeor equation
          </div>
        </div>

        <!-- Warning Box (hidden by default) -->
        <div class="warning-box" id="warning-box" style="display:none;">
          ⚠ Target calorie intake is below 1,200 kcal (women) or 1,500 kcal (men). Consider a moderate deficit or consult a dietitian.
        </div>

        <!-- Rest Day Target -->
        <p class="section-label">Calorie Targets</p>
        <div class="calorie-target" id="card-rest">
          <div class="calorie-target-header">Rest Day</div>
          <div class="calorie-input-row">
            <input type="number" id="input-rest-kcal" placeholder="Auto-calculated" />
            <span class="calorie-badge" id="rest-deficit-badge">— deficit</span>
          </div>
        </div>

        <!-- Workout Day Target -->
        <div class="calorie-target" id="card-workout">
          <div class="calorie-target-header">Workout Day</div>
          <div class="calorie-input-row">
            <input type="number" id="input-workout-kcal" placeholder="Auto-calculated" />
            <span class="calorie-badge" id="workout-deficit-badge">— deficit</span>
          </div>
        </div>

        <!-- Macro Split -->
        <p class="section-label" style="margin-top:24px;">Macro Split</p>
        <div class="macro-bars">
          <!-- Protein -->
          <div class="macro-row">
            <div class="macro-name" style="color:var(--red);">Protein</div>
            <div class="macro-bar-bg">
              <div class="macro-bar-fill" id="macro-bar-protein" style="width:0%;background:var(--red);"></div>
            </div>
            <div class="macro-val" id="macro-val-protein">—</div>
          </div>
          <!-- Carbs -->
          <div class="macro-row">
            <div class="macro-name" style="color:var(--blue);">Carbohydrates</div>
            <div class="macro-bar-bg">
              <div class="macro-bar-fill" id="macro-bar-carbs" style="width:0%;background:var(--blue);"></div>
            </div>
            <div class="macro-val" id="macro-val-carbs">—</div>
          </div>
          <!-- Fats -->
          <div class="macro-row">
            <div class="macro-name" style="color:var(--green);">Fats</div>
            <div class="macro-bar-bg">
              <div class="macro-bar-fill" id="macro-bar-fats" style="width:0%;background:var(--green);"></div>
            </div>
            <div class="macro-val" id="macro-val-fats">—</div>
          </div>
        </div>

        <!-- Calculate CTA -->
        <button class="gender-btn active" id="btn-calculate" style="width:100%;padding:15px;font-size:13px;letter-spacing:0.14em;border-radius:var(--radius);">
          ⚡ Calculate
        </button>

      </div><!-- /panel-right -->

    </div><!-- /main -->
  </div><!-- /tab-inputs -->


  <!-- ══════════════════════════════════════════════════════════════════════
       TAB PANEL — RESULTS
       ══════════════════════════════════════════════════════════════════════ -->
  <div class="tab-panel" id="tab-results" role="tabpanel">
    <div style="padding:26px 24px;">

      <p class="section-label">Key Metrics</p>

      <!-- 4 Metric Cards -->
      <div class="results-grid">
        <div class="metric-card accent">
          <div class="metric-label">Daily Deficit</div>
          <div class="metric-value red" id="res-daily-deficit">—</div>
          <div class="metric-sub">kcal below TDEE</div>
        </div>
        <div class="metric-card green-card">
          <div class="metric-label">Weekly Deficit</div>
          <div class="metric-value green" id="res-weekly-deficit">—</div>
          <div class="metric-sub">kcal / 7 days</div>
        </div>
        <div class="metric-card red-card">
          <div class="metric-label">Fat Loss / Week</div>
          <div class="metric-value red" id="res-fat-loss-week">—</div>
          <div class="metric-sub">kg per week</div>
        </div>
        <div class="metric-card">
          <div class="metric-label">Time to Goal</div>
          <div class="metric-value blue" id="res-time-to-goal">—</div>
          <div class="metric-sub">estimated weeks</div>
        </div>
      </div>

      <!-- Insight Strip -->
      <div class="insight-strip" id="insight-strip">
        <div class="insight-icon">💡</div>
        <div class="insight-text" id="insight-text">
          Enter your body metrics and hit <strong>Calculate</strong> to unlock your personalised metabolic breakdown.
        </div>
      </div>

      <!-- Chart: Weekly Calorie Cycle -->
      <div class="chart-title">Weekly Calorie Cycle</div>
      <div class="chart-wrap">
        <canvas id="chart-calories"></canvas>
      </div>

      <!-- Chart: Deficit vs Surplus -->
      <div class="chart-title" style="margin-top:16px;">Daily Deficit Balance</div>
      <div class="chart-wrap2">
        <canvas id="chart-deficit"></canvas>
      </div>

    </div>
  </div><!-- /tab-results -->


  <!-- ══════════════════════════════════════════════════════════════════════
       TAB PANEL — TIMELINE
       ══════════════════════════════════════════════════════════════════════ -->
  <div class="tab-panel" id="tab-timeline" role="tabpanel">
    <div style="padding:26px 24px;">

      <p class="section-label">Weight Loss Projection</p>

      <!-- Chart: Weight-loss trajectory -->
      <div class="chart-title">Body Weight Trajectory</div>
      <div class="chart-wrap" style="height:240px;margin-bottom:24px;">
        <canvas id="chart-timeline"></canvas>
      </div>

      <p class="section-label">Week-by-Week Breakdown</p>

      <!-- Timeline Rows List -->
      <div class="timeline-items" id="timeline-list">
        <!-- Populated by script.js -->
        <div class="timeline-row">
          <div class="timeline-week">Week —</div>
          <div class="timeline-bar-wrap"><div class="timeline-bar" style="width:0%;"></div></div>
          <div class="timeline-weight">— kg</div>
          <div class="timeline-delta">—</div>
        </div>
      </div>

    </div>
  </div><!-- /tab-timeline -->


  <!-- ══════════════════════════════════════════════════════════════════════
       SIGNATURE STAMP
       ══════════════════════════════════════════════════════════════════════ -->
  <div class="signature">Abhijeet Singh</div>


  <!-- External script -->
  <script src="script.js"></script>
</body>
</html>
